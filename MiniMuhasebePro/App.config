<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="DatabaseProvider" value="SQLite" />
    <add key="SqliteConnectionString" value="Data Source=minimuhasebe.db" />
    <add key="SqlServerConnectionString" value="Server=.;Database=MiniMuhasebePro;Trusted_Connection=True;" />
  </appSettings>
</configuration>
